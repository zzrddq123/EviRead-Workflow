# Linux host resource-plane binding template.
# Set ICLR_HOST_ROOT to the provisioned host resource plane root before sourcing.
EVIDENCE_BACKEND=local
EVIDENCE_PROFILE=sequence_structure
SEQUENCE_SEARCH_BACKEND=local
STRUCTURE_SEARCH_BACKEND=local
PYTHON_BIN=$ICLR_HOST_ROOT/linux-adapted-v1/env/bin/python
BLASTP_BIN=$ICLR_HOST_ROOT/linux-adapted-v1/bin/blastp
BLASTDBCMD_BIN=$ICLR_HOST_ROOT/linux-adapted-v1/bin/blastdbcmd
BLAST_DB=$ICLR_HOST_ROOT/linux-adapted-v1/databases/swissprot_2025_03_full
FOLDSEEK_BIN=$ICLR_HOST_ROOT/linux-adapted-v1/bin/foldseek
FOLDSEEK_SWISSPROT_DB=$ICLR_HOST_ROOT/linux-adapted-v1/afdb-swissprot-v5/afdb_swissprot_v5
FOLDSEEK_PDB_DB=$ICLR_HOST_ROOT/linux-adapted-v1/pdb100/pdb
GO_ONTOLOGY_OBO=$ICLR_HOST_ROOT/linux-adapted-v1/go-basic.obo
MERIZO_ROOT=$ICLR_HOST_ROOT/linux-adapted-v1/tools/merizo-41d12fb
MERIZO_PYTHON=$ICLR_HOST_ROOT/linux-adapted-v1/tools/merizo-41d12fb/.venv/bin/python
CHAINSAW_ROOT=$ICLR_HOST_ROOT/linux-adapted-v1/tools/chainsaw-9ced6e6
CHAINSAW_PYTHON=$ICLR_HOST_ROOT/linux-adapted-v1/tools/chainsaw-9ced6e6/.venv/bin/python
THREADS=2
TOP_K=8
ANNOTATION_LIMIT=16
CANDIDATE_PROVIDER_MODE=disabled
DEEPGOPLUS_MODE=local
DEEPGOPLUS_PYTHON=$ICLR_HOST_ROOT/linux-adapted-v1/deepgoplus/data-1.0.25/.venv/bin/python
DEEPGOPLUS_RUNNER=python/deepgoplus_cnn_predictor.py
DEEPGOPLUS_DATA_ROOT=$ICLR_HOST_ROOT/linux-adapted-v1/deepgoplus/data-1.0.25/data
DEEPGOPLUS_MODEL=$ICLR_HOST_ROOT/linux-adapted-v1/deepgoplus/data-1.0.25/data/model.h5
DEEPGOPLUS_TERMS=$ICLR_HOST_ROOT/linux-adapted-v1/deepgoplus/data-1.0.25/data/terms.pkl
DEEPGOPLUS_ONTOLOGY=$ICLR_HOST_ROOT/linux-adapted-v1/deepgoplus/data-1.0.25/data/go.obo
DEEPGOPLUS_PACKAGE_VERSION=1.0.2
DEEPGOPLUS_TENSORFLOW_VERSION=2.15.1
DEEPGOPLUS_NUMPY_VERSION=1.26.4
DEEPGOPLUS_PANDAS_VERSION=1.5.3
DEEPGOPLUS_DATA_RELEASE=1.0.25
DEEPGOPLUS_EXPORT_MIN_SCORE=0.10
DEEPGOPLUS_HYBRID_MODE=disabled
DEEPGOPLUS_DIAMOND_EXECUTABLE=$ICLR_HOST_ROOT/linux-adapted-v1/bin/diamond
OMA_LOCAL_PYTHON=$ICLR_HOST_ROOT/linux-adapted-v1/env/bin/python
OMA_LOCAL_RUNNER=$ICLR_HOST_ROOT/linux-adapted-v1/tools/oma-omamer/run_t0_omamer.py
OMA_LOCAL_BIN=$ICLR_HOST_ROOT/linux-adapted-v1/bin/omamer
OMA_LOCAL_DATABASE=$ICLR_HOST_ROOT/linux-adapted-v1/tools/oma-omamer/source/LUCA.h5
OMA_LOCAL_STORE=$ICLR_HOST_ROOT/linux-adapted-v1/tools/oma-omamer/t0_oma_luca_jul2024.sqlite3
OMA_LOCAL_MANIFEST=$ICLR_HOST_ROOT/linux-adapted-v1/tools/oma-omamer/t0_oma_luca_jul2024.manifest.json
OMA_LOCAL_THREADS=2
