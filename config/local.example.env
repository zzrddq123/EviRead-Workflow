# Prefer `./pi-agent bootstrap all --profile sequence_structure --accept-licenses`; it generates config/managed.env.
# This file is only for advanced users integrating a pre-provisioned HPC/runtime.
EVIDENCE_BACKEND=local
EVIDENCE_PROFILE=sequence_structure
PYTHON_BIN=/path/to/python3
BLASTP_BIN=/path/to/blastp
BLASTDBCMD_BIN=/path/to/blastdbcmd
BLAST_DB=/path/to/uniprot_sprot
FOLDSEEK_BIN=/path/to/foldseek
FOLDSEEK_SWISSPROT_DB=/path/to/foldseek/swissprot/afdb_swissprot
# Optional enrichments. Leave blank to use full-length Foldseek only.
FOLDSEEK_PDB_DB=
GO_ONTOLOGY_OBO=/path/to/go-basic.obo
MERIZO_ROOT=
MERIZO_PYTHON=
CHAINSAW_ROOT=
CHAINSAW_PYTHON=
THREADS=4
TOP_K=8
ANNOTATION_LIMIT=16
HTTP_TIMEOUT_SECONDS=25
# Storage-light GO candidate providers. This avoids downloading a full search
# database; requests and the small GO mapping tables are hash-cached locally.
CANDIDATE_PROVIDER_MODE=remote
INTERPROSCAN_EMAIL=you@example.org
INTERPROSCAN_REST_URL=https://www.ebi.ac.uk/Tools/services/rest/iprscan5
INTERPROSCAN_APPLICATIONS=PfamA,Panther,Gene3d
INTERPROSCAN_EXTERNAL2GO_ENABLED=true
GO_EXTERNAL2GO_BASE_URL=https://current.geneontology.org/ontology/external2go
OMA_REST_URL=https://omabrowser.org/api
# Arbitrary-sequence OMA FastMap is a single-donor local-similarity GO
# hypothesis source, not strict orthology/phylogeny. Set disabled to use only
# the strict full-length OMA entry-mapping channel.
OMA_FASTMAP_MODE=remote
OMA_FASTMAP_REST_URL=https://omabrowser.org/api
OMA_FASTMAP_REQUEST_TIMEOUT_MS=30000
OMA_FASTMAP_MAX_CANDIDATES=120
REMOTE_CANDIDATE_CACHE_DIR=.runtime/cache/candidate_sources
# Optional DeepGOPlus learned lane. It is disabled by default and deliberately
# exports CNN-only, pre-ontology scores; the stock DIAMOND+CNN TSV is not fused
# because homology and GO closure are already handled by the host.
DEEPGOPLUS_MODE=disabled
DEEPGOPLUS_PYTHON=.runtime/predictors/deepgoplus-cnn-v1/bin/python
DEEPGOPLUS_RUNNER=python/deepgoplus_cnn_predictor.py
DEEPGOPLUS_DATA_ROOT=.databases/deepgoplus-v1
DEEPGOPLUS_PACKAGE_VERSION=1.0.2
DEEPGOPLUS_TENSORFLOW_VERSION=2.15.1
DEEPGOPLUS_NUMPY_VERSION=1.26.4
DEEPGOPLUS_PANDAS_VERSION=1.5.3
DEEPGOPLUS_DATA_RELEASE=1.0.28
DEEPGOPLUS_EXPORT_MINIMUM_SCORE=0.01
DEEPGOPLUS_TIMEOUT_MS=600000
# Optional full DeepGOPlus lane (DIAMOND + sequence CNN). This is a separate,
# explicitly enabled adapter: the stock propagated vector is retained for
# audit, while the agent receives only raw-annotation direct scores and applies
# its own safe is_a/part_of closure. Exact/near-exact training matches are
# quarantined from agent fusion.
DEEPGOPLUS_HYBRID_MODE=disabled
DEEPGOPLUS_HYBRID_RUNNER=python/deepgoplus_hybrid_predictor.py
DEEPGOPLUS_DIAMOND_EXECUTABLE=.runtime/predictors/deepgoplus-cnn-v1/bin/diamond
DEEPGOPLUS_HYBRID_EXPORT_MINIMUM_SCORE=0.01
DEEPGOPLUS_HYBRID_TIMEOUT_MS=900000
DEEPGOPLUS_MAX_STDOUT_BYTES=52428800
# Optional proxy, for example: HTTPS_PROXY=http://127.0.0.1:7890
