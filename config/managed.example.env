# Generated automatically as config/managed.env by bootstrap/bootstrap.py.
# `local` here means the Python evidence process runs in this clone; the two
# search-backend settings below determine where sequence/structure search runs.
EVIDENCE_BACKEND=local
EVIDENCE_PROFILE=local_blast
SEQUENCE_SEARCH_BACKEND=local
STRUCTURE_SEARCH_BACKEND=foldseek_remote
PYTHON_BIN=.runtime/env/bin/python
SSL_CERT_FILE=.runtime/env/ssl/cacert.pem
BLASTP_BIN=.runtime/env/bin/blastp
BLASTDBCMD_BIN=.runtime/env/bin/blastdbcmd
BLAST_DB=.databases/uniprot_swissprot/blastdb/uniprot_sprot
FOLDSEEK_BIN=.runtime/env/bin/foldseek
FOLDSEEK_SWISSPROT_DB=
FOLDSEEK_PDB_DB=
GO_ONTOLOGY_OBO=.databases/gene_ontology/go-basic.obo
NCBI_BLAST_URL=https://blast.ncbi.nlm.nih.gov/blast/Blast.cgi
NCBI_BLAST_DATABASE=swissprot
# `remote_broad` generates swissprot,nr_cluster_seq here and submits one
# independently paced/cached RID per database.
NCBI_BLAST_DATABASES=swissprot
NCBI_BLAST_EMAIL=
NCBI_BLAST_TOOL=FunctionPredAgent07B
NCBI_BLAST_CACHE_DIR=.runtime/cache/ncbi_remote_blast
NCBI_BLAST_REQUEST_TIMEOUT_SECONDS=60
NCBI_BLAST_JOB_TIMEOUT_SECONDS=1800
# Live Swiss-Prot RIDs can remain queued beyond 30 minutes; keep a larger but
# finite lane-specific bound. Broad clustered-NR receives a still larger bound.
# Database-specific values override the global bound without weakening the
# one-minute RID polling minimum.
NCBI_BLAST_JOB_TIMEOUT_SECONDS_SWISSPROT=3600
NCBI_BLAST_JOB_TIMEOUT_SECONDS_NR_CLUSTER_SEQ=7200
NCBI_BLAST_MAX_RESPONSE_BYTES=52428800
NCBI_BLAST_REQUEST_INTERVAL_SECONDS=10
NCBI_BLAST_POLL_INTERVAL_SECONDS=60
NCBI_BLAST_MAX_ATTEMPTS=3
NCBI_BLAST_REFRESH=false
FOLDSEEK_REMOTE_URL=https://search.foldseek.com/api
FOLDSEEK_REMOTE_DATABASES=afdb-swissprot,pdb100
# tmalign is required by the current scorer: validated API score/e-value fields
# can reconstruct qTM/tTM; 3diaa does not expose those metrics.
FOLDSEEK_REMOTE_MODE=tmalign
FOLDSEEK_REMOTE_TIMEOUT_SECONDS=30
FOLDSEEK_REMOTE_MAX_WAIT_SECONDS=900
FOLDSEEK_REMOTE_POLL_SECONDS=5
FOLDSEEK_REMOTE_MAX_ATTEMPTS=3
FOLDSEEK_REMOTE_BACKOFF_BASE_SECONDS=1
FOLDSEEK_REMOTE_BACKOFF_MAX_SECONDS=30
FOLDSEEK_REMOTE_BACKOFF_JITTER_FRACTION=0.2
FOLDSEEK_REMOTE_SUBMISSION_INTERVAL_SECONDS=5
FOLDSEEK_REMOTE_PACER_DIR=.runtime/cache/foldseek_remote
FOLDSEEK_REMOTE_REFRESH=false
FOLDSEEK_REMOTE_CACHE_DIR=.runtime/cache/foldseek_remote
MERIZO_ROOT=
CHAINSAW_ROOT=
THREADS=4
TOP_K=8
ANNOTATION_LIMIT=16
HTTP_TIMEOUT_SECONDS=25
CANDIDATE_PROVIDER_MODE=remote
INTERPROSCAN_EMAIL=you@example.org
INTERPROSCAN_REST_URL=https://www.ebi.ac.uk/Tools/services/rest/iprscan5
INTERPROSCAN_APPLICATIONS=PfamA,Panther,Gene3d
INTERPROSCAN_EXTERNAL2GO_ENABLED=true
GO_EXTERNAL2GO_BASE_URL=https://current.geneontology.org/ontology/external2go
OMA_REST_URL=https://omabrowser.org/api
# FastMap is storage-light local-sequence-similarity evidence; it does not
# populate strict OMA orthology relations or phylogeny distances.
OMA_FASTMAP_MODE=remote
OMA_FASTMAP_REST_URL=https://omabrowser.org/api
OMA_FASTMAP_REQUEST_TIMEOUT_MS=30000
OMA_FASTMAP_MAX_CANDIDATES=120
REMOTE_CANDIDATE_CACHE_DIR=.runtime/cache/candidate_sources
# Optional local DeepGOPlus CNN-only candidate lane. Bootstrap does not install
# it yet; these portable paths describe the required managed layout.
DEEPGOPLUS_MODE=disabled
DEEPGOPLUS_PYTHON=.runtime/predictors/deepgoplus-cnn-v1/bin/python
DEEPGOPLUS_RUNNER=python/deepgoplus_cnn_predictor.py
DEEPGOPLUS_DATA_ROOT=.databases/deepgoplus-v1
DEEPGOPLUS_PACKAGE_VERSION=1.0.2
DEEPGOPLUS_TENSORFLOW_VERSION=2.15.1
DEEPGOPLUS_NUMPY_VERSION=1.26.4
DEEPGOPLUS_PANDAS_VERSION=1.5.3
DEEPGOPLUS_DATA_RELEASE=1.0.28
DEEPGOPLUS_EXPORT_MINIMUM_SCORE=0.01
DEEPGOPLUS_TIMEOUT_MS=600000
# Full DIAMOND+CNN adapter. Bootstrap/doctor do not yet provision or certify
# this developer-local runtime; it remains disabled until DeepGOPlus, DIAMOND
# and all bound data artifacts are installed in the paths above.
DEEPGOPLUS_HYBRID_MODE=disabled
DEEPGOPLUS_HYBRID_RUNNER=python/deepgoplus_hybrid_predictor.py
DEEPGOPLUS_DIAMOND_EXECUTABLE=.runtime/predictors/deepgoplus-cnn-v1/bin/diamond
DEEPGOPLUS_HYBRID_EXPORT_MINIMUM_SCORE=0.01
DEEPGOPLUS_HYBRID_TIMEOUT_MS=900000
DEEPGOPLUS_MAX_STDOUT_BYTES=52428800
