# CodeBase1: EviRead BioLM-only resource plane.
EVIREAD_PROFILE=model_only
# The unified CodeBase1 pipeline always includes semantic GO Agent judgment.
EVIREAD_REQUIRE_SEMANTIC_GO_AGENT=1
EVIREAD_BIOLM_EVIDENCE=/path/to/biolm-evidence.v1.json
EVIDENCE_BACKEND=disabled
# These are deliberately absent: BLASTP, Foldseek, OMA, InterPro, DeepGOPlus,
# mDeepFRI, and all other conventional search/tool providers.
CANDIDATE_PROVIDER_MODE=disabled
OMA_MODE=disabled
OMA_FASTMAP_MODE=disabled
DEEPGOPLUS_MODE=disabled
MDEEPFRI_CNN_ENABLED=false
MDEEPFRI_GCN_ENABLED=false
