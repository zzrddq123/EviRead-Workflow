# Thin-client mode: no local Python, BLAST, Foldseek, Merizo, Chainsaw, or databases required.
EVIDENCE_BACKEND=http
EVIDENCE_API_URL=https://evidence.example.org
# Use a secret manager or shell environment in production instead of committing a token.
EVIDENCE_API_TOKEN=replace-me
EVIDENCE_API_TIMEOUT_MS=3900000
EVIDENCE_API_HEALTH_TIMEOUT_MS=15000

# The current HTTP worker returns the Python evidence bundle/manifest/summary;
# storage-light InterPro/OMA candidate requests still execute client-side after
# that response. Enable them here (and provide INTERPROSCAN_EMAIL plus the same
# settings as managed.example.env) when the thin client should collect them.
CANDIDATE_PROVIDER_MODE=disabled
# Optional client-side OMA FastMap. It is disabled in this minimal example.
OMA_FASTMAP_MODE=disabled
OMA_FASTMAP_REST_URL=https://omabrowser.org/api
OMA_FASTMAP_REQUEST_TIMEOUT_MS=30000
OMA_FASTMAP_MAX_CANDIDATES=120
# A thin client has no local DeepGOPlus runtime unless explicitly provisioned.
DEEPGOPLUS_MODE=disabled
DEEPGOPLUS_HYBRID_MODE=disabled

# Optional network proxy for Pi model and evidence-service requests.
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost
