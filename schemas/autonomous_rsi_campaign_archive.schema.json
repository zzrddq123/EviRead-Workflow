{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-autonomous-rsi-campaign-archive.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "campaignId", "baselineCommit", "evaluatorContractHash", "objective", "terminalStatus", "stopReason", "selectedCandidateId", "selectedSourceCommit", "candidateGraphHash", "eventHeadHash", "knowledgeHeadHash", "candidates", "baseDecisions", "knowledgeCards", "claimBoundary", "canonicalHash"],
  "properties": {
    "schemaVersion": { "const": "pi-autonomous-rsi-campaign-archive.v1" },
    "campaignId": { "$ref": "#/$defs/safeId" },
    "baselineCommit": { "$ref": "#/$defs/gitObject" },
    "evaluatorContractHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "objective": { "type": "object" },
    "terminalStatus": { "enum": ["completed", "stopped"] },
    "stopReason": { "type": "string", "minLength": 1 },
    "selectedCandidateId": { "$ref": "#/$defs/safeIdLong" },
    "selectedSourceCommit": { "$ref": "#/$defs/gitObject" },
    "candidateGraphHash": { "$ref": "#/$defs/hash" },
    "eventHeadHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "knowledgeHeadHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "candidates": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "baseDecisions": { "type": "array", "items": { "type": "object" } },
    "knowledgeCards": { "type": "array", "items": { "type": "object" } },
    "claimBoundary": { "const": "development campaign archive; complete code snapshots, aggregate evaluations, and sanitized lessons; not formal scientific promotion" },
    "canonicalHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$" },
    "safeIdLong": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitObject": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }
  }
}
