{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/schemas/autonomous_rsi_development_baseline.schema.json",
  "title": "Autonomous RSI Development Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baselineId", "codeIdentity", "runtimeBinding", "retrospectiveObservation", "evidenceBindings", "claimBoundary", "requiredConfirmation", "canonicalHash"],
  "properties": {
    "schemaVersion": { "const": "pi-autonomous-rsi-development-baseline.v1" },
    "baselineId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "codeIdentity": { "type": "object" },
    "runtimeBinding": {
      "type": "object",
      "required": ["modelProvider", "modelId", "thinkingLevel", "maxCandidates", "maxDonorContexts", "genomePath", "genomeSha256"]
    },
    "retrospectiveObservation": { "type": "object" },
    "evidenceBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "claimBoundary": { "type": "string", "minLength": 1 },
    "requiredConfirmation": { "type": "string", "minLength": 1 },
    "canonicalHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
