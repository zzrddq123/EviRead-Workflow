{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-autonomous-rsi-strategy-decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["planId", "baseCandidateId", "branchAction", "baseRationale", "historyEvidenceIds", "knowledgeEvidenceIds", "hypothesis", "changeTargets", "controls", "falsifiers", "rollbackCondition"],
  "properties": {
    "planId": { "$ref": "#/$defs/safeId" },
    "baseCandidateId": { "$ref": "#/$defs/safeId" },
    "branchAction": { "enum": ["continue", "backtrack", "branch"] },
    "baseRationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "historyEvidenceIds": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "knowledgeEvidenceIds": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "hypothesis": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "changeTargets": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1200 } },
    "controls": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 1200 } },
    "falsifiers": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 1200 } },
    "rollbackCondition": { "type": "string", "minLength": 1, "maxLength": 2000 }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$" }
  }
}
