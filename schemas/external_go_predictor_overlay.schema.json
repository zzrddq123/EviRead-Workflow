{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://function-pred-agent.local/schemas/external_go_predictor_overlay.schema.json",
  "title": "Receipt-bound mDeepFRI CNN GO predictor overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "base",
    "method",
    "caseCount",
    "cases",
    "predictionSetHash",
    "claimBoundary",
    "canonicalHash"
  ],
  "properties": {
    "schemaVersion": { "const": "pi-external-go-predictor-overlay.v1" },
    "base": { "$ref": "#/$defs/base" },
    "method": { "$ref": "#/$defs/method" },
    "caseCount": { "type": "integer", "minimum": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    },
    "predictionSetHash": { "$ref": "#/$defs/hash" },
    "claimBoundary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "canonicalHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+@-]{0,127}$"
    },
    "aspect": {
      "enum": ["molecular_function", "biological_process", "cellular_component"]
    },
    "publicCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "sequenceSha256"],
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^CASE_[0-9]{3}_[A-F0-9]{8}$"
        },
        "sequenceSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suiteId",
        "publicManifestHash",
        "baseBatchManifestHash",
        "acquisitionPlanHash",
        "acquisitionReceiptHash",
        "baseFrozenEvidenceSetHash",
        "orderedPublicCases"
      ],
      "properties": {
        "suiteId": { "$ref": "#/$defs/safeId" },
        "publicManifestHash": { "$ref": "#/$defs/hash" },
        "baseBatchManifestHash": { "$ref": "#/$defs/hash" },
        "acquisitionPlanHash": { "$ref": "#/$defs/hash" },
        "acquisitionReceiptHash": { "$ref": "#/$defs/hash" },
        "baseFrozenEvidenceSetHash": { "$ref": "#/$defs/hash" },
        "orderedPublicCases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/publicCase" }
        }
      }
    },
    "modelFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect", "paramsSha256", "onnxSha256"],
      "properties": {
        "aspect": { "$ref": "#/$defs/aspect" },
        "paramsSha256": { "$ref": "#/$defs/hash" },
        "onnxSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "sourceType",
        "annotationEvidenceCode",
        "architecture",
        "exportMinimumScore",
        "toolName",
        "packageName",
        "packageVersion",
        "runnerSha256",
        "modelSha256",
        "modelConfigSha256",
        "modelFiles",
        "methodHash"
      ],
      "properties": {
        "provider": { "const": "mDeepFRI" },
        "sourceType": { "const": "mdeepfri_cnn" },
        "annotationEvidenceCode": { "const": "MODEL" },
        "architecture": { "const": "cnn" },
        "exportMinimumScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "toolName": { "$ref": "#/$defs/safeId" },
        "packageName": { "$ref": "#/$defs/safeId" },
        "packageVersion": { "$ref": "#/$defs/safeId" },
        "runnerSha256": { "$ref": "#/$defs/hash" },
        "modelSha256": { "$ref": "#/$defs/hash" },
        "modelConfigSha256": { "$ref": "#/$defs/hash" },
        "modelFiles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/modelFile" },
                { "properties": { "aspect": { "const": "molecular_function" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/modelFile" },
                { "properties": { "aspect": { "const": "biological_process" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/modelFile" },
                { "properties": { "aspect": { "const": "cellular_component" } } }
              ]
            }
          ],
          "items": false
        },
        "methodHash": { "$ref": "#/$defs/hash" }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goId", "termName", "aspect", "score"],
      "properties": {
        "goId": { "type": "string", "pattern": "^GO:[0-9]{7}$" },
        "termName": { "type": "string", "minLength": 1, "maxLength": 512 },
        "aspect": { "$ref": "#/$defs/aspect" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "go_id",
        "term_name",
        "aspect",
        "source_type",
        "source_id",
        "mapping_id",
        "provider",
        "provider_release",
        "provider_payload_sha256",
        "evidence_id",
        "provenance_root",
        "base_score",
        "query_coverage",
        "domain_range",
        "query_like",
        "annotation_evidence_code",
        "donor_accession",
        "phylogeny"
      ],
      "properties": {
        "schema_version": { "const": "pi-go-candidate.v1" },
        "go_id": { "type": "string", "pattern": "^GO:[0-9]{7}$" },
        "term_name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "aspect": { "$ref": "#/$defs/aspect" },
        "source_type": { "const": "mdeepfri_cnn" },
        "source_id": { "type": "string", "minLength": 1 },
        "mapping_id": { "type": "string", "minLength": 1 },
        "provider": { "const": "mDeepFRI" },
        "provider_release": { "type": "string", "minLength": 1 },
        "provider_payload_sha256": { "$ref": "#/$defs/hash" },
        "evidence_id": { "type": "string", "pattern": "^CAND-MDF-[a-f0-9]{16}$" },
        "provenance_root": { "type": "string", "pattern": "^mdeepfri:[a-f0-9]{64}$" },
        "base_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "query_coverage": { "type": "null" },
        "domain_range": { "type": "null" },
        "query_like": { "const": false },
        "annotation_evidence_code": { "const": "MODEL" },
        "donor_accession": { "type": "null" },
        "phylogeny": { "type": "null" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "sequenceSha256",
        "requestSha256",
        "dependencyRoot",
        "rawPredictionHash",
        "rawPredictions",
        "candidates",
        "canonicalHash"
      ],
      "properties": {
        "caseId": { "type": "string", "pattern": "^CASE_[0-9]{3}_[A-F0-9]{8}$" },
        "sequenceSha256": { "$ref": "#/$defs/hash" },
        "requestSha256": { "$ref": "#/$defs/hash" },
        "dependencyRoot": { "type": "string", "pattern": "^mdeepfri:[a-f0-9]{64}$" },
        "rawPredictionHash": { "$ref": "#/$defs/hash" },
        "rawPredictions": {
          "type": "array",
          "items": { "$ref": "#/$defs/prediction" }
        },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidate" }
        },
        "canonicalHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
