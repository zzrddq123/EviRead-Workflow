{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-function-prediction.v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "proteinId", "targetMode", "targetContext", "narrativeMode", "mostLikelyFunction", "functionalDescription",
    "confidence", "confidenceRationale", "keyEvidence", "alternatives", "conflictingEvidence",
    "limitations", "recommendedExperiments", "goPrediction"
  ],
  "properties": {
    "schemaVersion": { "const": "pi-function-prediction.v4" },
    "proteinId": { "type": "string", "minLength": 1 },
    "targetMode": { "enum": ["anonymous", "named_uncharacterized"] },
    "targetContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taxon", "phylogeny"],
      "properties": {
        "taxon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["taxonId", "provenance"],
          "properties": {
            "taxonId": { "type": ["integer", "null"], "minimum": 1 },
            "provenance": { "enum": ["provided", "unavailable"] }
          }
        },
        "phylogeny": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "status"],
          "properties": {
            "mode": { "enum": ["optional", "required"] },
            "status": { "enum": ["requested", "unavailable_missing_taxon"] }
          }
        }
      }
    },
    "narrativeMode": { "enum": ["pi", "deterministic"] },
    "mostLikelyFunction": { "type": "string", "minLength": 1 },
    "functionalDescription": { "type": "string", "minLength": 1 },
    "confidence": { "enum": ["high", "medium", "low", "insufficient"] },
    "confidenceRationale": { "type": "string", "minLength": 1 },
    "keyEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "supports"],
        "properties": { "evidenceId": { "type": "string" }, "supports": { "type": "string" } }
      }
    },
    "alternatives": { "type": "array" },
    "conflictingEvidence": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "recommendedExperiments": { "type": "array", "items": { "type": "string" } },
    "goPrediction": { "$ref": "go_prediction.schema.json" }
  }
}
