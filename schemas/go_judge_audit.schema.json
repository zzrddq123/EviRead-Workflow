{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "go-evidence-judge-audit-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "attempts", "canonicalHash"],
  "properties": {
    "schemaVersion": {"const": "go-evidence-judge-audit-v1"},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "requestedMode", "status", "modelProvider", "modelId", "thinkingLevel", "stats", "failureReason"],
        "properties": {
          "schemaVersion": {"const": "go-evidence-judge-execution-v1"},
          "requestedMode": {"enum": ["deterministic", "pi"]},
          "status": {"enum": ["completed", "failed"]},
          "modelProvider": {"type": "string", "minLength": 1},
          "modelId": {"type": "string", "minLength": 1},
          "thinkingLevel": {"type": "string", "minLength": 1},
          "stats": {
            "type": "object",
            "additionalProperties": false,
            "required": ["userMessages", "assistantMessages", "toolCalls", "inputTokens", "outputTokens", "totalTokens"],
            "properties": {
              "userMessages": {"type": "integer", "minimum": 0},
              "assistantMessages": {"type": "integer", "minimum": 0},
              "toolCalls": {"type": "integer", "minimum": 0},
              "inputTokens": {"type": "integer", "minimum": 0},
              "outputTokens": {"type": "integer", "minimum": 0},
              "totalTokens": {"type": "integer", "minimum": 0}
            }
          },
          "failureReason": {"type": ["string", "null"], "maxLength": 500}
        }
      }
    },
    "canonicalHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
