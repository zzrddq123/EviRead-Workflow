{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "go-evidence-judge-result-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "viewHash", "modeUsed", "decisions"],
  "properties": {
    "schemaVersion": {"const": "go-evidence-judge-result-v1"},
    "viewHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "modeUsed": {"enum": ["deterministic", "pi"]},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateToken", "verdict", "citedEvidenceIds", "factor"],
        "properties": {
          "candidateToken": {"type": "string", "pattern": "^cand_[a-f0-9]{16,64}$"},
          "verdict": {"enum": ["support", "uncertain", "contradict"]},
          "citedEvidenceIds": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "factor": {"enum": [1.05, 0.85, 0.4]}
        }
      }
    }
  }
}
