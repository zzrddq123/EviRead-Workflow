{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "go-evidence-judge-view-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "viewHash", "candidates"],
  "properties": {
    "schemaVersion": {"const": "go-evidence-judge-view-v1"},
    "viewHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateToken", "hypothesisName", "aspect", "evidence"],
        "properties": {
          "candidateToken": {"type": "string", "pattern": "^cand_[a-f0-9]{16,64}$"},
          "hypothesisName": {"type": "string", "minLength": 1, "maxLength": 180, "not": {"pattern": "GO:[0-9]{7}"}},
          "aspect": {"enum": ["molecular_function", "biological_process", "cellular_component", "unknown"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidenceId", "channel", "direction", "strength", "independenceGroup"],
              "properties": {
                "evidenceId": {"type": "string", "minLength": 1, "maxLength": 128},
                "channel": {"enum": ["sequence", "structure", "domain", "orthology", "phylogeny", "taxonomy", "ontology"]},
                "direction": {"enum": ["support", "neutral", "contradict"]},
                "strength": {"enum": ["weak", "moderate", "strong"]},
                "independenceGroup": {"type": "string", "minLength": 1, "maxLength": 96}
              }
            }
          }
        }
      }
    }
  }
}
