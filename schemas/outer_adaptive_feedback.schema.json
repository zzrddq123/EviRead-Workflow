{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "pi-outer-adaptive-feedback.v1",
  "title": "Aggregate adaptive30 CAFA and Teacher feedback", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "campaignId", "objectiveHash", "round", "generation", "proposalHash", "cohortRole", "metricInterpretation", "freeze", "control", "challenger", "teacher", "finalGeneralizationAllowed", "freshHoldoutRequired", "claimBoundary", "canonicalHash"],
  "properties": {
    "schemaVersion": { "const": "pi-outer-adaptive-feedback.v1" }, "campaignId": { "$ref": "#/$defs/id" }, "objectiveHash": { "$ref": "#/$defs/hash" }, "round": { "type": "integer", "minimum": 1, "maximum": 32 }, "generation": { "type": "integer", "minimum": 1, "maximum": 32 }, "proposalHash": { "$ref": "#/$defs/hash" },
    "cohortRole": { "const": "adaptive_development" }, "metricInterpretation": { "const": "in_sample_descriptive_only" },
    "freeze": { "type": "object", "additionalProperties": false, "required": ["receiptHash", "openingHash", "state", "controlPredictionHash", "challengerPredictionHash", "crossfitIsolation"], "properties": { "receiptHash": { "$ref": "#/$defs/hash" }, "openingHash": { "$ref": "#/$defs/hash" }, "state": { "enum": ["training_opened_after_all_blind_replays_persisted", "grouped_crossfit_completed_from_presealed_routes"] }, "controlPredictionHash": { "$ref": "#/$defs/hash" }, "challengerPredictionHash": { "$ref": "#/$defs/hash" }, "crossfitIsolation": { "oneOf": [{ "$ref": "#/$defs/crossfit" }, { "type": "null" }] } } },
    "control": { "type": "object", "additionalProperties": false, "required": ["predictionSetId", "metrics"], "properties": { "predictionSetId": { "$ref": "#/$defs/id" }, "metrics": { "$ref": "#/$defs/metrics" } } },
    "challenger": { "type": "object", "additionalProperties": false, "required": ["predictionSetId", "metrics", "pairedDelta", "overallFmaxGain", "maximumPopulatedAspectFmaxDrop", "decision"], "properties": { "predictionSetId": { "$ref": "#/$defs/id" }, "metrics": { "$ref": "#/$defs/metrics" }, "pairedDelta": { "type": "object" }, "overallFmaxGain": { "type": "number" }, "maximumPopulatedAspectFmaxDrop": { "type": "number", "minimum": 0 }, "decision": { "enum": ["selected_successor", "reject_no_gain", "reject_aspect_guardrail", "reject_falsifier"] } } },
    "teacher": { "type": "object", "additionalProperties": false, "required": ["detailed", "causal", "researchCardBundleHash"], "properties": { "detailed": { "oneOf": [{ "type": "object" }, { "type": "null" }] }, "causal": { "type": "object" }, "researchCardBundleHash": { "$ref": "#/$defs/hash" } } },
    "finalGeneralizationAllowed": { "const": false }, "freshHoldoutRequired": { "const": true }, "claimBoundary": { "type": "string", "minLength": 1, "maxLength": 1000 }, "canonicalHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
    "scope": { "type": "object", "additionalProperties": false, "required": ["evaluable", "proteinCount", "fmax", "precisionAtFmax", "recallAtFmax", "coverageAtFmax", "aupr", "smin"], "properties": { "evaluable": { "type": "boolean" }, "proteinCount": { "type": "integer", "minimum": 0, "maximum": 30 }, "fmax": { "$ref": "#/$defs/nullableNumber" }, "precisionAtFmax": { "$ref": "#/$defs/nullableNumber" }, "recallAtFmax": { "$ref": "#/$defs/nullableNumber" }, "coverageAtFmax": { "$ref": "#/$defs/nullableNumber" }, "aupr": { "$ref": "#/$defs/nullableNumber" }, "smin": { "$ref": "#/$defs/nullableNumber" } } },
    "nullableNumber": { "oneOf": [{ "type": "number" }, { "type": "null" }] },
    "metrics": { "type": "object", "additionalProperties": false, "required": ["overall", "aspects"], "properties": { "overall": { "$ref": "#/$defs/scope" }, "aspects": { "type": "object", "additionalProperties": false, "required": ["molecular_function", "biological_process", "cellular_component"], "properties": { "molecular_function": { "$ref": "#/$defs/scope" }, "biological_process": { "$ref": "#/$defs/scope" }, "cellular_component": { "$ref": "#/$defs/scope" } } } } },
    "crossfit": { "type": "object", "additionalProperties": false, "required": ["foldCount", "groupingPolicy", "ownFoldLabelsUsed", "informationContentPolicy", "presealedRouteSetHash", "foldAssignmentHash", "crossfitReceiptHash"], "properties": { "foldCount": { "const": 5 }, "groupingPolicy": { "const": "homology_group_no_split_v1" }, "ownFoldLabelsUsed": { "const": false }, "informationContentPolicy": { "const": "training_fold_only" }, "presealedRouteSetHash": { "$ref": "#/$defs/hash" }, "foldAssignmentHash": { "$ref": "#/$defs/hash" }, "crossfitReceiptHash": { "$ref": "#/$defs/hash" } } }
  }
}
