{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "pi-outer-adaptive-outcome.v1",
  "title": "Persistent adaptive30 iteration knowledge", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "campaignId", "objectiveHash", "round", "generation", "parentGeneration", "proposalHash", "previousOutcomeHash", "feedbackHash", "result", "knowledge", "lineageAttempts", "claimPolicy", "claimBoundary", "canonicalHash"],
  "properties": {
    "schemaVersion": { "const": "pi-outer-adaptive-outcome.v1" }, "campaignId": { "$ref": "#/$defs/id" }, "objectiveHash": { "$ref": "#/$defs/hash" }, "round": { "type": "integer", "minimum": 1, "maximum": 32 }, "generation": { "type": "integer", "minimum": 1, "maximum": 32 }, "parentGeneration": { "type": "integer", "minimum": 0, "maximum": 31 }, "proposalHash": { "$ref": "#/$defs/hash" }, "previousOutcomeHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "feedbackHash": { "$ref": "#/$defs/hash" },
    "result": { "type": "object", "additionalProperties": false, "required": ["decision", "retainedGeneration", "retainedPredictionSetId", "controlDevelopmentFmax", "challengerDevelopmentFmax", "developmentFmaxGain"], "properties": { "decision": { "enum": ["selected_successor", "reject_no_gain", "reject_aspect_guardrail", "reject_falsifier"] }, "retainedGeneration": { "type": "integer", "minimum": 0, "maximum": 32 }, "retainedPredictionSetId": { "$ref": "#/$defs/id" }, "controlDevelopmentFmax": { "type": "number", "minimum": 0, "maximum": 1 }, "challengerDevelopmentFmax": { "type": "number", "minimum": 0, "maximum": 1 }, "developmentFmaxGain": { "type": "number", "minimum": -1, "maximum": 1 } } },
    "knowledge": { "type": "object", "additionalProperties": false, "required": ["problemCodes", "hypothesis", "researchCardBundleHash", "authorizedByMethodPlanHash", "authorizedByDeveloperPlanHash", "externalEvidenceIds", "changeSummary", "hypothesisVerdict", "mechanismVerdict", "teacherDiagnoses", "prioritizedActions"], "properties": { "problemCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "hypothesis": { "type": "string", "minLength": 1, "maxLength": 1000 }, "researchCardBundleHash": { "$ref": "#/$defs/hash" }, "authorizedByMethodPlanHash": { "oneOf": [{ "$ref": "#/$defs/prefixedHash" }, { "type": "null" }] }, "authorizedByDeveloperPlanHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "externalEvidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^EXT-[0-9]{4}$" } }, "changeSummary": { "type": "string", "minLength": 1, "maxLength": 1000 }, "hypothesisVerdict": { "enum": ["supported", "partially_supported", "falsified", "not_tested"] }, "mechanismVerdict": { "enum": ["pipeline_invariant_violation", "inactive", "localized_gain_precision_tradeoff", "no_material_effect", "general_gain", "cross_aspect_interference", "localized_gain", "general_regression", "not_evaluable"] }, "teacherDiagnoses": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "prioritizedActions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } } },
    "lineageAttempts": { "type": "array", "maxItems": 128, "items": { "type": "object" } },
    "claimPolicy": { "type": "object", "additionalProperties": false, "required": ["cohort", "heldOutClaim", "promotionClaim", "leaderboardClaim", "directPaperComparison", "populationGeneralization"], "properties": { "cohort": { "const": "adaptive_development_only" }, "heldOutClaim": { "const": "forbidden" }, "promotionClaim": { "const": "forbidden" }, "leaderboardClaim": { "const": "forbidden" }, "directPaperComparison": { "const": "forbidden" }, "populationGeneralization": { "const": "forbidden" } } },
    "claimBoundary": { "type": "string", "minLength": 1, "maxLength": 1000 }, "canonicalHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "prefixedHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" } }
}
