{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-rsi-code-evaluation-opening.v1",
  "title": "Pre-evaluation opening for one immutable RSI code version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evaluationId",
    "tagRef",
    "version",
    "protocol",
    "state",
    "canonicalHash"
  ],
  "properties": {
    "schemaVersion": { "const": "pi-rsi-code-evaluation-opening.v1" },
    "evaluationId": { "$ref": "#/$defs/id" },
    "tagRef": {
      "type": "string",
      "pattern": "^refs/tags/rsi/evaluation/[a-z0-9][a-z0-9._-]{0,63}/opening$"
    },
    "version": { "$ref": "#/$defs/versionBinding" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolId", "protocolHash"],
      "properties": {
        "protocolId": { "$ref": "#/$defs/id" },
        "protocolHash": { "$ref": "#/$defs/hash" }
      }
    },
    "state": { "const": "opened_before_private_evaluation" },
    "canonicalHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "oid": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "versionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionId",
        "manifestHash",
        "sourceCommit",
        "tagObjectId"
      ],
      "properties": {
        "versionId": { "$ref": "#/$defs/id" },
        "manifestHash": { "$ref": "#/$defs/hash" },
        "sourceCommit": { "$ref": "#/$defs/oid" },
        "tagObjectId": { "$ref": "#/$defs/oid" }
      }
    }
  }
}
