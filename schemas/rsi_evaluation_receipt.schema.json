{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "pi-rsi-evaluation-receipt.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "manifestHash", "campaignId", "evaluationId", "split", "candidate", "parentCandidateId", "updateIndex", "evaluatorCallIndex", "evaluatorContractHash", "privateArtifactHash", "developerViewHash", "feedbackPolicy", "primary", "metricsCompleteness", "metrics", "slices", "deltas", "decision", "codeChange", "recordedAt", "canonicalHash"],
  "properties": {
    "schemaVersion": { "const": "pi-rsi-evaluation-receipt.v1" }, "manifestHash": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" }, "campaignId": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/id" }, "evaluationId": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/id" }, "split": { "enum": ["development", "sealed"] }, "candidate": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/candidate" }, "parentCandidateId": { "anyOf": [{ "$ref": "pi-rsi-experiment-defs.v1#/$defs/id" }, { "type": "null" }] }, "updateIndex": { "type": "integer", "minimum": 0 }, "evaluatorCallIndex": { "type": "integer", "minimum": 1 }, "evaluatorContractHash": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" }, "privateArtifactHash": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" }, "developerViewHash": { "anyOf": [{ "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" }, { "type": "null" }] }, "feedbackPolicy": { "enum": ["metric_only", "structured_diagnostic", null] },
    "primary": { "type": "object", "additionalProperties": false, "required": ["metricId", "value", "direction", "threshold"], "properties": { "metricId": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/id" }, "value": { "type": "number" }, "direction": { "enum": ["maximize", "minimize"] }, "threshold": { "type": ["number", "null"] } } },
    "metricsCompleteness": { "enum": ["primary_only", "canonical_16"] },
    "metrics": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "scope", "metric", "direction", "value", "threshold", "proteinCount"], "properties": { "label": { "type": "string" }, "scope": { "enum": ["overall", "molecular_function", "biological_process", "cellular_component"] }, "metric": { "enum": ["Fmax", "AUPR", "IA-wFmax", "nSmin", "Smin", "fixed_precision", "fixed_recall"] }, "direction": { "enum": ["maximize", "minimize"] }, "value": { "type": ["number", "null"] }, "threshold": { "type": ["number", "null"] }, "proteinCount": { "type": "integer", "minimum": 0 } } } },
    "slices": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["sliceId", "proteinCount", "metricId", "value"], "properties": { "sliceId": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/id" }, "proteinCount": { "type": "integer", "minimum": 0 }, "metricId": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/id" }, "value": { "type": ["number", "null"] } } } },
    "deltas": { "type": "object", "additionalProperties": false, "required": ["fromParent", "fromInitial", "fromBestBefore"], "properties": { "fromParent": { "type": ["number", "null"] }, "fromInitial": { "type": ["number", "null"] }, "fromBestBefore": { "type": ["number", "null"] } } },
    "decision": { "enum": ["initial", "promote", "retain_parent", "record_only"] },
    "codeChange": { "type": "object", "additionalProperties": false, "required": ["parentCommit", "sourceCommit", "sourceTree", "diffHash", "changedPaths", "insertions", "deletions"], "properties": { "parentCommit": { "anyOf": [{ "$ref": "pi-rsi-experiment-defs.v1#/$defs/oid" }, { "type": "null" }] }, "sourceCommit": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/oid" }, "sourceTree": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/oid" }, "diffHash": { "anyOf": [{ "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" }, { "type": "null" }] }, "changedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "insertions": { "type": ["integer", "null"], "minimum": 0 }, "deletions": { "type": ["integer", "null"], "minimum": 0 } } },
    "recordedAt": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/timestamp" }, "canonicalHash": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" }
  }
}
