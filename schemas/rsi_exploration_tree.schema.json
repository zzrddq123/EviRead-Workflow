{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-rsi-exploration-tree.v1",
  "title": "Deterministic public index of immutable RSI Developer explorations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "graphHead",
    "policy",
    "entries",
    "canonicalHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "pi-rsi-exploration-tree.v1"
    },
    "graphHead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventSequence",
        "eventManifestHash",
        "selectedVersionId",
        "paperComplete",
        "readyForNextVersion"
      ],
      "properties": {
        "eventSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999999
        },
        "eventManifestHash": { "$ref": "#/$defs/hash" },
        "selectedVersionId": { "$ref": "#/$defs/id" },
        "paperComplete": { "const": true },
        "readyForNextVersion": { "type": "boolean" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "evaluatorPrivateMaterial"],
      "properties": {
        "authority": {
          "const": "immutable_rsi_tags_and_events_markdown_is_reproducible_view"
        },
        "evaluatorPrivateMaterial": {
          "const": "never_exported"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/entry" }
    },
    "canonicalHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "oid": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256", "size"],
      "properties": {
        "relativePath": {
          "type": "string",
          "pattern": "^versions/[a-z0-9][a-z0-9._-]{0,63}/(?:evaluation_analysis|next_optimization_plan)\\.md$"
        },
        "sha256": { "$ref": "#/$defs/hash" },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explorationId",
        "manifestHash",
        "tagObjectId",
        "sourceVersionId",
        "baseVersionId",
        "evaluationId",
        "action",
        "plannedVersionId",
        "evaluationAnalysisHash",
        "planHash",
        "artifacts"
      ],
      "properties": {
        "explorationId": { "$ref": "#/$defs/id" },
        "manifestHash": { "$ref": "#/$defs/hash" },
        "tagObjectId": { "$ref": "#/$defs/oid" },
        "sourceVersionId": { "$ref": "#/$defs/id" },
        "baseVersionId": { "$ref": "#/$defs/id" },
        "evaluationId": { "$ref": "#/$defs/id" },
        "action": { "enum": ["proceed", "stop"] },
        "plannedVersionId": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "evaluationAnalysisHash": { "$ref": "#/$defs/hash" },
        "planHash": { "$ref": "#/$defs/hash" },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluationAnalysisMarkdown",
            "nextOptimizationPlanMarkdown"
          ],
          "properties": {
            "evaluationAnalysisMarkdown": { "$ref": "#/$defs/artifact" },
            "nextOptimizationPlanMarkdown": { "$ref": "#/$defs/artifact" }
          }
        }
      }
    }
  }
}
