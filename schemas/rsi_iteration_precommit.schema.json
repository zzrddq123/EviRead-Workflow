{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "pi-rsi-iteration-precommit.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "manifestHash", "campaignId", "updateIndex", "patchAttempt", "currentCandidate", "baseCandidate", "feedbackExposure", "historyExposure", "diagnosis", "intervention", "preActionSourceHash", "recordedAt", "canonicalHash"],
  "properties": {
    "schemaVersion": { "const": "pi-rsi-iteration-precommit.v1" }, "manifestHash": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" }, "campaignId": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/id" },
    "updateIndex": { "type": "integer", "minimum": 0 }, "patchAttempt": { "type": "integer", "minimum": 1 },
    "currentCandidate": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/candidate" }, "baseCandidate": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/candidate" },
    "feedbackExposure": { "type": "object", "additionalProperties": false, "required": ["policy", "privateEvaluationHash", "developerViewHash"], "properties": { "policy": { "enum": ["metric_only", "structured_diagnostic"] }, "privateEvaluationHash": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" }, "developerViewHash": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" } } },
    "historyExposure": { "type": "object", "additionalProperties": false, "required": ["policy", "contextHash", "recordCount", "matchedArtifactHash"], "properties": { "policy": { "enum": ["reset", "persistent", "shuffled", "native_linear"] }, "contextHash": { "anyOf": [{ "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" }, { "type": "null" }] }, "recordCount": { "type": "integer", "minimum": 0 }, "matchedArtifactHash": { "anyOf": [{ "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" }, { "type": "null" }] } } },
    "diagnosis": { "type": "object", "additionalProperties": false, "required": ["problemCodes", "summary", "rootCause"], "properties": { "problemCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "summary": { "type": "string", "minLength": 1 }, "rootCause": { "type": "string", "minLength": 1 } } },
    "intervention": { "type": "object", "additionalProperties": false, "required": ["changeFamily", "changeTargets", "hypothesis", "predictedEffects", "guardrails", "falsifiers", "rollbackCondition"], "properties": { "changeFamily": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/id" }, "changeTargets": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "hypothesis": { "type": "string", "minLength": 1 }, "predictedEffects": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["metricId", "sliceId", "direction", "minimumDelta"], "properties": { "metricId": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/id" }, "sliceId": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/id" }, "direction": { "enum": ["increase", "decrease", "unchanged"] }, "minimumDelta": { "type": ["number", "null"] } } } }, "guardrails": { "type": "array", "items": { "type": "string" } }, "falsifiers": { "type": "array", "items": { "type": "string" } }, "rollbackCondition": { "type": "string", "minLength": 1 } } },
    "preActionSourceHash": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" }, "recordedAt": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/timestamp" }, "canonicalHash": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" }
  }
}
