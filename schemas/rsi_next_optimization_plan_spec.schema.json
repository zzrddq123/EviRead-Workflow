{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-rsi-next-optimization-plan-spec.v2",
  "title": "Developer-authored pre-implementation optimization intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "action",
    "plannedVersionId",
    "problemAssessment",
    "problemCodes",
    "hypothesis",
    "plannedChangeSummary",
    "codeChangeTargets",
    "controls",
    "expectedEffects",
    "experiment",
    "researchCards",
    "rollbackCondition",
    "claimBoundary",
    "canonicalHash"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "pi-rsi-next-optimization-plan-spec.v1",
        "pi-rsi-next-optimization-plan-spec.v2"
      ]
    },
    "baseVersionId": { "$ref": "#/$defs/id" },
    "action": {
      "enum": ["proceed", "stop"]
    },
    "plannedVersionId": {
      "oneOf": [
        { "$ref": "#/$defs/id" },
        { "type": "null" }
      ]
    },
    "problemAssessment": { "$ref": "#/$defs/text" },
    "problemCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/problemCode" }
    },
    "hypothesis": { "$ref": "#/$defs/text" },
    "plannedChangeSummary": { "$ref": "#/$defs/text" },
    "codeChangeTargets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/shortText" }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/shortText" }
    },
    "expectedEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "molecularFunction",
        "biologicalProcess",
        "cellularComponent"
      ],
      "properties": {
        "overall": { "$ref": "#/$defs/effect" },
        "molecularFunction": { "$ref": "#/$defs/effect" },
        "biologicalProcess": { "$ref": "#/$defs/effect" },
        "cellularComponent": { "$ref": "#/$defs/effect" }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "strategy",
        "requiredCapabilities",
        "falsifiers"
      ],
      "properties": {
        "component": { "$ref": "#/$defs/component" },
        "strategy": { "$ref": "#/$defs/text" },
        "requiredCapabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "falsifiers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/shortText" }
        }
      }
    },
    "researchCards": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/researchCard" }
    },
    "rollbackCondition": { "$ref": "#/$defs/text" },
    "claimBoundary": {
      "const": "Developer-visible aggregate evaluation analysis and pre-implementation plan only; no gold GO labels, target identities, sequences, per-protein errors, evaluator-private paths, or evaluator-private artifacts."
    },
    "canonicalHash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "pi-rsi-next-optimization-plan-spec.v2"
          }
        },
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["baseVersionId"]
      },
      "else": {
        "not": {
          "required": ["baseVersionId"]
        }
      }
    },
    {
      "if": {
        "properties": { "action": { "const": "proceed" } },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "plannedVersionId": { "$ref": "#/$defs/id" }
        }
      },
      "else": {
        "properties": {
          "plannedVersionId": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "effect": {
      "enum": ["improve", "hold", "not_targeted"]
    },
    "problemCode": {
      "enum": [
        "candidate_recall_risk",
        "precision_risk",
        "aspect_tradeoff_risk",
        "score_calibration_risk",
        "source_correlation_risk",
        "pipeline_activation_risk",
        "method_saturation_risk",
        "evidence_coverage_risk",
        "ontology_consistency_risk"
      ]
    },
    "component": {
      "enum": [
        "candidate_generation",
        "evidence_acquisition",
        "external_tool_fusion",
        "ontology_reasoning",
        "aspect_routing",
        "score_calibration",
        "go_selection",
        "pipeline"
      ]
    },
    "researchCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "finding",
        "limitations",
        "supportedComponents"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "pattern": "^EXT-[0-9]{4}$"
        },
        "finding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/shortText" }
        },
        "supportedComponents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/component" }
        }
      }
    }
  }
}
