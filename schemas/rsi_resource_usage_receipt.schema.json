{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "pi-rsi-resource-usage-receipt.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "manifestHash", "campaignId", "updateIndex", "patchAttempt", "stage", "attempt", "startedAt", "finishedAt", "wallClockMs", "exitCode", "status", "usage", "errorClass", "stdoutHash", "stderrHash", "canonicalHash"],
  "properties": {
    "schemaVersion": { "const": "pi-rsi-resource-usage-receipt.v1" }, "manifestHash": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" }, "campaignId": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/id" }, "updateIndex": { "type": "integer", "minimum": 0 }, "patchAttempt": { "type": "integer", "minimum": 0 }, "stage": { "type": "string", "minLength": 1 }, "attempt": { "type": "integer", "minimum": 1 }, "startedAt": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/timestamp" }, "finishedAt": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/timestamp" }, "wallClockMs": { "type": "integer", "minimum": 0 }, "exitCode": { "type": "integer", "minimum": -255, "maximum": 255 }, "status": { "enum": ["completed", "retryable_failure", "fatal_failure", "invalid_candidate"] },
    "usage": { "type": "object", "additionalProperties": false, "required": ["inputTokens", "outputTokens", "cacheReadTokens", "cacheWriteTokens", "modelCalls", "toolCalls", "evaluatorCalls", "costUsd"], "properties": { "inputTokens": { "type": ["integer", "null"], "minimum": 0 }, "outputTokens": { "type": ["integer", "null"], "minimum": 0 }, "cacheReadTokens": { "type": ["integer", "null"], "minimum": 0 }, "cacheWriteTokens": { "type": ["integer", "null"], "minimum": 0 }, "modelCalls": { "type": ["integer", "null"], "minimum": 0 }, "toolCalls": { "type": ["integer", "null"], "minimum": 0 }, "evaluatorCalls": { "type": "integer", "minimum": 0 }, "costUsd": { "type": ["number", "null"], "minimum": 0 } } },
    "errorClass": { "anyOf": [{ "$ref": "pi-rsi-experiment-defs.v1#/$defs/id" }, { "type": "null" }] }, "stdoutHash": { "anyOf": [{ "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" }, { "type": "null" }] }, "stderrHash": { "anyOf": [{ "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" }, { "type": "null" }] }, "canonicalHash": { "$ref": "pi-rsi-experiment-defs.v1#/$defs/hash" }
  }
}
