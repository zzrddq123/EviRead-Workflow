{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-rsi-retrospective-experiment.v1",
  "title": "Immutable knowledge-only record of a post-hoc RSI experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "tagRef",
    "recordCommit",
    "evaluatedSource",
    "receipt",
    "formalSelection",
    "experiment",
    "archive",
    "policies",
    "claimBoundary",
    "canonicalHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "pi-rsi-retrospective-experiment.v1"
    },
    "recordId": { "$ref": "#/$defs/id" },
    "tagRef": {
      "type": "string",
      "pattern": "^refs/tags/rsi/retrospective/[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "recordCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit", "sourceTree"],
      "properties": {
        "sourceCommit": { "$ref": "#/$defs/oid" },
        "sourceTree": { "$ref": "#/$defs/oid" }
      }
    },
    "evaluatedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit", "sourceTree"],
      "properties": {
        "sourceCommit": { "$ref": "#/$defs/oid" },
        "sourceTree": { "$ref": "#/$defs/oid" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "blobObjectId",
        "fileSha256",
        "canonicalHash",
        "size"
      ],
      "properties": {
        "relativePath": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
          "maxLength": 512
        },
        "blobObjectId": { "$ref": "#/$defs/oid" },
        "fileSha256": { "$ref": "#/$defs/hash" },
        "canonicalHash": { "$ref": "#/$defs/hash" },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "formalSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedVersion",
        "eventSequence",
        "eventManifestHash",
        "formalDecisionMutation"
      ],
      "properties": {
        "selectedVersion": { "$ref": "#/$defs/versionBinding" },
        "eventSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999999
        },
        "eventManifestHash": { "$ref": "#/$defs/hash" },
        "formalDecisionMutation": { "type": "null" }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changeSummary",
        "hypothesis",
        "component",
        "observations",
        "diagnoses",
        "prioritizedActions",
        "localGateOutcome"
      ],
      "properties": {
        "changeSummary": { "$ref": "#/$defs/text" },
        "hypothesis": { "$ref": "#/$defs/text" },
        "component": { "$ref": "#/$defs/component" },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/observation" }
        },
        "diagnoses": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/diagnosis" }
        },
        "prioritizedActions": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/action" }
        },
        "localGateOutcome": {
          "enum": [
            "retain_experiment_control",
            "prefer_experiment_candidate",
            "inconclusive"
          ]
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archiveSealHash", "publicManifestHash"],
      "properties": {
        "archiveSealHash": { "$ref": "#/$defs/hash" },
        "publicManifestHash": { "$ref": "#/$defs/hash" }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceTiming",
        "graphRole",
        "selectionEligibility",
        "promotionEligibility",
        "artifactRetention"
      ],
      "properties": {
        "evidenceTiming": {
          "const": "retrospective_post_hoc_without_pre_evaluation_opening"
        },
        "graphRole": {
          "const": "knowledge_only_not_a_code_version_node"
        },
        "selectionEligibility": {
          "const": "ineligible_never_updates_selected_version"
        },
        "promotionEligibility": {
          "const": "ineligible_not_prospective_evidence"
        },
        "artifactRetention": {
          "const": "external_hash_bound_archive_required"
        }
      }
    },
    "claimBoundary": {
      "const": "Retrospective post-hoc aggregate observation only; not a prospectively registered RSI code version or evaluation, not eligible to update formal selection, and not evidence for promotion."
    },
    "canonicalHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "oid": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "versionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionId",
        "manifestHash",
        "sourceCommit",
        "tagObjectId"
      ],
      "properties": {
        "versionId": { "$ref": "#/$defs/id" },
        "manifestHash": { "$ref": "#/$defs/hash" },
        "sourceCommit": { "$ref": "#/$defs/oid" },
        "tagObjectId": { "$ref": "#/$defs/oid" }
      }
    },
    "component": {
      "enum": [
        "candidate_generation",
        "evidence_acquisition",
        "external_tool_fusion",
        "ontology_reasoning",
        "aspect_routing",
        "score_calibration",
        "go_selection",
        "pipeline"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationId",
        "cohortRole",
        "metric",
        "baseline",
        "candidate",
        "candidateMinusBaseline",
        "interpretation"
      ],
      "properties": {
        "observationId": { "$ref": "#/$defs/id" },
        "cohortRole": {
          "enum": [
            "development",
            "calibration",
            "development_calibration",
            "selection",
            "test",
            "all_descriptive"
          ]
        },
        "metric": { "const": "fmax" },
        "baseline": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "candidate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "candidateMinusBaseline": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "interpretation": {
          "enum": [
            "development_signal",
            "selection_gate",
            "descriptive_only"
          ]
        }
      }
    },
    "diagnosis": {
      "enum": [
        "pipeline_stage_count_inconsistent",
        "learned_channel_inactive",
        "learned_channel_dropped_before_admission",
        "learned_channel_dropped_before_selection_eligibility",
        "learned_channel_not_selected",
        "learned_channel_activation_sparse",
        "method_no_material_effect",
        "method_localized_gain",
        "precision_recall_tradeoff",
        "cross_aspect_interference",
        "method_general_gain",
        "method_general_regression",
        "effect_not_evaluable",
        "candidate_rejected_by_aspect_guardrail",
        "candidate_not_retained",
        "same_mechanism_saturated"
      ]
    },
    "action": {
      "enum": [
        "repair_pipeline_invariant",
        "activate_method_channel",
        "inspect_admission_gate",
        "inspect_selection_eligibility_gate",
        "add_new_router",
        "add_new_calibrator",
        "isolate_effective_aspect_path",
        "switch_exhausted_mechanism",
        "change_predictor_or_information_source",
        "validate_on_fresh_cohort",
        "hold_baseline"
      ]
    }
  }
}
